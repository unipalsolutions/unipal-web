# Copy to apps/<app>/.env.local for local development.

# Laravel API base URL (server side). Empty = contact form only logs, hub uses demo sign-in.
UNIPAL_API_URL=
NEXT_PUBLIC_API_URL=
# production | staging | local. Anything but production adds noindex.
NEXT_PUBLIC_SITE_ENV=local

# Hub: internal app download links, filled by the unipal-apps release workflow.
NEXT_PUBLIC_DOWNLOAD_ANDROID=
NEXT_PUBLIC_DOWNLOAD_IOS=
NEXT_PUBLIC_DOWNLOAD_WINDOWS=
NEXT_PUBLIC_DOWNLOAD_MACOS=
